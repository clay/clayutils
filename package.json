{
  "name": "clayutils",
  "version": "3.0.0",
  "description": "A collection of utility functions for working with Clay.",
  "main": "index.js",
  "browser": "dist/index.js",
  "scripts": {
    "generate-readme": "node docs/generate-readme.js && git add README.md",
    "lint": "eslint lib test index.js index.test.js",
    "test-local": "node --test",
    "test": "npm run lint && npm run build && node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-exclude=\"**/*.test.js\" --test-coverage-lines=100 --test-coverage-functions=100",
    "build": "vite build",
    "watch": "vite build --watch",
    "prepack": "vite build"
  },
  "pre-commit": [
    "generate-readme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clay/clayutils.git"
  },
  "keywords": [
    "clay"
  ],
  "author": "New York Media",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/clay/clayutils/issues"
  },
  "files": [
    "/dist",
    "/lib",
    "!**/*.test.js"
  ],
  "homepage": "https://github.com/clay/clayutils#readme",
  "devDependencies": {
    "chalk": "^1.1.3",
    "eslint": "^4.18.2",
    "handlebars": "^4.7.10",
    "lodash": "^4.17.4",
    "nymag-fs": "^1.0.0",
    "pre-commit": "^1.2.2",
    "vite": "8.3.5"
  }
}
